{
  "Auth": {
    "Authority": "http://keycloak:8080/realms/order-platform",
    "ValidIssuer": "http://localhost:8081/realms/order-platform",
    "Audience": "order-platform-api"
  },
  "RateLimiting": {
    "PermitLimit": 20,
    "WindowSeconds": 10
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "order",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/orders/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "products": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/products/{**rest}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "payments": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "customer",
        "Match": { "Path": "/api/payments/{**rest}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "notifications": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "customer",
        "Match": { "Path": "/api/notifications/{**rest}", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "order": { "Destinations": { "main": { "Address": "http://order-service:8080/" } } },
      "inventory": { "Destinations": { "main": { "Address": "http://inventory-service:8080/" } } },
      "payment": { "Destinations": { "main": { "Address": "http://payment-service:8080/" } } },
      "notification": { "Destinations": { "main": { "Address": "http://notification-service:8080/" } } }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
